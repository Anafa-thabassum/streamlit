# Optional. Raises GitHub's public API rate limit from 60 to 5,000 requests/hour.
GITHUB_TOKEN=

# Storage and refresh settings. Relative paths are resolved from this project folder.
DATABASE_PATH=data/profiles.db
REPORTS_DIR=reports
FETCH_INTERVAL_DAYS=7
REQUEST_TIMEOUT_SECONDS=15
MAX_WORKERS=6
USER_AGENT=ProfileTracker/1.0 (public-profile analytics; contact: your-email@example.com)

